# Copy to .env and adjust.

DATABASE_URL="file:./dev.db"
PORT=4000

# How long a resolved search stays cached before re-matching, in minutes.
SEARCH_CACHE_TTL_MINUTES=30

# How many paginated pages to pull per catalog source during `npm run ingest`
# (e.g. per Shopify collection, or per Carter's category page). Each page is
# ~250 products for Shopify stores, ~48 for Carter's.
INGEST_MAX_PAGES_PER_SOURCE=2

# OpenRouter (https://openrouter.ai/keys) powers free-text product matching
# -- write a description in your own words and the LLM finds the closest
# matching product per store. Leave blank to fall back to plain keyword
# matching (still works, just less forgiving of paraphrasing).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional shared secret required on POST /api/admin/ingest (X-Admin-Token
# header). Leave unset for local/dev use.
ADMIN_TOKEN=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
