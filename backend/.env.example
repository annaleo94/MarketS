# Copy to .env and adjust.

DATABASE_URL="file:./dev.db"
PORT=4000

# How long a search result stays cached before we re-scrape stores, in minutes.
SEARCH_CACHE_TTL_MINUTES=30

# Live (real-site) scrapers are OFF by default -- see backend/src/scrapers/adapters/README.md
# before turning this on. With it off, MarketS runs entirely on the bundled
# demo stores so the app is fully usable out of the box.
ENABLE_LIVE_SCRAPERS=false

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
