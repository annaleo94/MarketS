// MarketS price-comparison database schema.
// Postgres in production (deployed against a managed Lathe instance).
// For local dev without a Postgres server handy, point DATABASE_URL at any
// Postgres you have (docker, a free-tier host, etc) -- SQLite was dropped
// once this stopped being a zero-setup demo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String    @id @default(cuid())
  key       String    @unique // matches the adapter's `key`, e.g. "fox", "shilav"
  name      String
  baseUrl   String
  logoUrl   String?
  isLive    Boolean   @default(true) // true = real store data, false = demo/mock data
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
}

// The indexed catalog: one row per product we've ingested from a store's
// baby/kids-clothing category. Populated by `npm run ingest`
// (backend/src/catalog/ingest.ts), not per-search -- search reads this
// table instead of hitting stores live on every request.
model Product {
  id                 String   @id @default(cuid())
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id])
  externalId         String // the store's own product id/handle
  title              String
  price              Float
  currency           String   @default("ILS")
  url                String
  imageUrl           String?
  category           String?
  inStock            Boolean  @default(true)
  // Some stores (Fox, notably) publish no colour at all -- not in the
  // title, not as a variant option. Colour is resolved once at ingest,
  // from the title where it's stated and otherwise from the product photo,
  // so colour searches can reach that inventory too. See catalog/colors.ts.
  color              String?
  colorSource        String? // "title" | "vision" | "none" (looked at the photo, couldn't tell)
  // 0..1, set only when colorSource is "vision" -- a title match is a plain
  // keyword hit, not a probabilistic guess, so it has no meaningful
  // confidence score. Not yet used to filter or gate anything; captured so
  // low-confidence rows can be found and reviewed once that exists.
  colorConfidence    Float?
  // Multipacks ("מארז 3 בגדי גוף") are one listing holding several garments
  // in different colours, so a single `color` can't describe them: this
  // holds every colour in the pack, comma-separated, and `color` is the
  // first of them. One colour for an ordinary single-garment product.
  colors             String?
  // Comma-separated size labels as the store lists them ("3M,6M,12M" or
  // "2,3,4"), so an age/size in the query can be matched against stock.
  sizes              String?
  // Hard-filter fields. categorySlug is a node in catalog/taxonomy.ts;
  // gender is boys|girls|unisex and defaults to unisex when unknown, so an
  // unclassified product is shown to everyone rather than hidden.
  categorySlug       String?
  // "store" | "title" (both deterministic alias matches, see
  // classify.ts's resolveCategory) | "text-llm" | "vision". Lets a
  // probabilistic source be told apart from an exact rule match, and is
  // what enrich-category.ts's low-confidence vision follow-up keys off of.
  categorySource     String?
  // 0..1, set only for "text-llm"/"vision" sources -- same reasoning as
  // colorConfidence: a deterministic alias match isn't a probabilistic
  // guess. Read by enrich-category.ts to decide whether a text-LLM answer
  // is trustworthy enough to skip the (slower, costlier) vision look.
  categoryConfidence Float?
  gender             String   @default("unisex")
  storeGender        String? // whatever the store itself said, kept for auditing
  // False for colour-blocked/patterned garments, where a single colour name
  // is misleading -- a cream shirt with mustard sleeves is not what someone
  // asking for a white shirt means. Null when unknown.
  colorIsSolid       Boolean?
  // Whether an overall/pants-family garment has built-in closed feet
  // ("עם רגליות") or open ankles ("בלי רגליות") -- rarely stated in the
  // title, so it's read off the product photo the same way colour is.
  // Only meaningful (and only ever populated) for categorySlug values in
  // LEG_STYLE_CATEGORIES (see catalog/taxonomy.ts); "footed" | "footless".
  legStyle           String?
  legStyleSource     String? // "title" | "vision" | "none" (looked, couldn't tell)
  legStyleConfidence Float? // 0..1, set only when legStyleSource is "vision"

  // --- price & availability history ---------------------------------
  // Maintained on every sync so a card can say "ירד מ-₪99" without
  // reading the event log; ProductEvent below keeps the full timeline.
  //
  // The store's own "before" price where it publishes one (Shopify's
  // compare_at_price, Magento's oldPrice). Null means the store doesn't
  // say -- which is NOT the same as "not on sale", so a price drop we
  // observed ourselves is tracked separately in previousPrice.
  listPrice      Float?
  previousPrice  Float? // the last price we saw that differed from the current one
  priceChangedAt DateTime? // when the current price first appeared
  lowestPrice    Float? // cheapest we have ever seen it
  highestPrice   Float? // dearest we have ever seen it
  // A product that vanishes from a store's feed is kept, not deleted --
  // otherwise "חזר למלאי" could never be detected, since the row holding
  // its history would already be gone. Search filters on inStock, so a
  // delisted row stops showing up without losing what we know about it.
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now()) // last sync that found it in the feed
  delistedAt     DateTime? // set when it left the feed, cleared when it returns
  // How many syncs in a row have not seen this product. Castro's crawl is
  // measurably non-deterministic -- two runs three hours apart returned
  // 1,014 and 973 products, a 4% swing with no real inventory change
  // behind it -- so a single miss means nothing. Only a product missing
  // MISSED_SYNCS_BEFORE_DELIST times running is treated as actually gone.
  missedSyncs    Int       @default(0)

  // The badge a saved-list row shows: in_stock_unchanged | price_dropped |
  // out_of_stock | on_sale | back_in_stock. Written by the sync, not
  // computed when someone opens a screen -- a shopper who hasn't opened
  // the site for a week must find the badge already up to date, and the
  // sync is the only thing that knows the feed changed.
  displayStatus   String?
  statusChangedAt DateTime? // when it entered that status (back_in_stock fades after 48h)

  events    ProductEvent[]
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  @@unique([storeId, externalId])
  @@index([storeId])
}

// The timeline behind Product's price/availability summary fields: one
// row per observed change, never per sync. A sync that finds nothing
// changed writes nothing here, so this grows with real retail activity
// rather than with how often the job happens to run.
model ProductEvent {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // "listed"        -- first time we ever saw it
  // "price-drop"    -- price went down
  // "price-rise"    -- price went up
  // "sale-start"    -- the store began publishing a higher "before" price
  // "sale-end"      -- that "before" price went away
  // "out-of-stock"  -- every size sold out (still listed)
  // "back-in-stock" -- stock returned after being out
  // "delisted"      -- disappeared from the store's feed entirely
  // "relisted"      -- came back after being delisted
  kind       String
  oldPrice   Float?
  newPrice   Float?
  listPrice  Float? // the store's own "before" price at the time, if any
  observedAt DateTime @default(now())

  @@index([productId, observedAt])
  @@index([kind, observedAt])
}

// One row per sync run -- what ran, when, how long it took, and what
// changed. Kept so "is the sync actually running, and is it healthy?"
// is answerable from data rather than by reading container logs, and so
// the scheduler can tell from the DB (not from in-process state, which a
// restart loses) when the last run finished.
model SyncRun {
  id          String    @id @default(cuid())
  trigger     String // "schedule" | "manual"
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  storesJson  String? // per-store fetched/delisted/changed counts
  newProducts Int       @default(0)
  priceDrops  Int       @default(0)
  priceRises  Int       @default(0)
  backInStock Int       @default(0)
  outOfStock  Int       @default(0)
  delisted    Int       @default(0)
  relisted    Int       @default(0)
  error       String?

  @@index([startedAt])
}

// One row per distinct free-text search we've already resolved, so
// repeat searches within the TTL window skip re-querying the LLM.
// `resultsJson` holds the final, already-sorted SearchResultItem[]
// (see backend/src/services/search.service.ts) -- small and read-mostly,
// so a JSON blob is simpler here than a relational join table.
model SearchCache {
  id              String   @id @default(cuid())
  normalizedQuery String   @unique
  rawQuery        String
  resultsJson     String
  fetchedAt       DateTime @default(now())
}
